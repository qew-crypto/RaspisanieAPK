[Unit]
Description=Schedule monitor for the school app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/raspisanie/host
EnvironmentFile=/opt/raspisanie/host/.env
ExecStart=/opt/raspisanie/host/venv/bin/python monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
